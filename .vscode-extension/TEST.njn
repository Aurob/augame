-- Test file for NJN extension validation

-- Valid line with correct parameter counts
id 1 player position 0 0 0 shape 1 1 0 color 1 1 1 1 player

-- Invalid: position should have 3 values (x, y, z)
id 2 entity2 position 3.0 shape 1 1 0

-- Invalid: color should have 4 values (r, g, b, a)
id 3 entity3 position 0 0 0 shape 1 1 0 color 1 1 1

-- Invalid: player should have no parameters
id 4 entity4 position 0 0 0 player extraParam

-- Valid: meta has 2 parameters
meta scene "world1"

-- Invalid: movement should have 4 values (speed, mass, restitution, friction)
id 5 entity5 position 0 0 0 movement 500 1

-- Valid: interior used as tag (no parameters)
id 6 building position 5 5 0 shape 10 10 0 interior collidable

-- Valid: interior with parameter
id 7 building2 position 10 10 0 shape 10 10 0 interior true collidable

-- Invalid: interior with wrong number of parameters (should be 0 or 1)
id 8 building3 position 15 15 0 shape 10 10 0 interior true false

-- Valid: hoverable as tag
id 9 button position 20 20 0 shape 1 1 0 hoverable interactable 1 0

-- Valid: hoverable with parameter
id 10 button2 position 25 25 0 shape 1 1 0 hoverable 5 interactable 1 0

{
  "name": "njn-entity-config",
  "displayName": "NJN Entity Configuration",
  "description": "Language support for Augame .njn entity configs",
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.70.0"
  },
  "publisher": "rau-dev",
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:njn"],
  "main": "./extension.js",
  "contributes": {
    "languages": [{
      "id": "njn",
      "aliases": ["NJN Entity Config"],
      "extensions": [".njn"],
      "configuration": "./language-configuration.json"
    }],
    "semanticTokenTypes": [
      { "id": "keyword", "description": "Keywords like id, meta" },
      { "id": "property", "description": "Component names" },
      { "id": "string", "description": "String values" },
      { "id": "number", "description": "Numeric values" },
      { "id": "comment", "description": "Comments" },
      { "id": "variable", "description": "Entity names and references" },
      { "id": "type", "description": "Meta types" }
    ],
    "semanticTokenModifiers": [
      { "id": "declaration", "description": "Entity declarations" },
      { "id": "readonly", "description": "File references" },
      { "id": "meta", "description": "Meta tags" }
    ]
  }
}
